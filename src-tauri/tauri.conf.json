{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RoFlow",
  "version": "0.1.0",
  "identifier": "dev.roflow.desktop",
  "build": {
    "frontendDist": "../web"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "RoFlow",
        "width": 1440,
        "height": 900,
        "minWidth": 1080,
        "minHeight": 680,
        "center": true,
        "resizable": true,
        "devtools": false,
        "browserExtensionsEnabled": false,
        "zoomHotkeysEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "shortDescription": "AI-assisted Roblox development workflow"
  }
}
